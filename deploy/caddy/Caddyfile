hustca.cn {
	encode zstd gzip
	root * /srv/mainpage/current
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

touranki.1037.games {
	encode zstd gzip

	@api path /api/* /healthz
	handle @api {
		reverse_proxy touranki-server:8080
	}

	handle {
		root * /srv/touranki
		@fresh path / /index.html /sw.js /app.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

pg.hustca.cn {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
	reverse_proxy password-game:8080 {
		header_up X-Game-Client-IP {remote_host}
	}
}
